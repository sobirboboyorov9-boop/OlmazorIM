{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "pnpm run typecheck && pnpm -r --filter \"@workspace/api-server\" --filter \"@workspace/alberuni\" --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.3",
    "prisma": "8.0.0-rc.21",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@prisma/composer": "0.28.0",
    "@prisma/composer-prisma-cloud": "0.28.0",
    "alchemy": "2.0.0-beta.78",
    "effect": "4.0.0-rc.115"
  },
  "pnpm": {
    "overrides": {
      "@effect/platform-bun": "4.0.0-rc.115",
      "@effect/platform-node": "4.0.0-rc.115",
      "@effect/platform-node-shared": "4.0.0-rc.115",
      "@effect/sql-d1": "4.0.0-rc.115",
      "@effect/sql-mysql2": "4.0.0-rc.115",
      "@effect/sql-pg": "4.0.0-rc.115",
      "@effect/sql-sqlite-do": "4.0.0-rc.115",
      "@effect/vitest": "4.0.0-rc.115",
      "effect": "4.0.0-rc.115"
    }
  }
}
